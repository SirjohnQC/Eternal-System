{
  "name": "eternal-systems",
  "version": "0.1.0",
  "description": "A procedural AI-driven God Simulation game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:invariants": "esbuild tools/invariantCheck.ts --bundle --platform=node --format=esm --outfile=.cache/invariants.mjs --log-level=warning && node .cache/invariants.mjs",
    "test:smoke": "esbuild tools/smokeTest.ts --bundle --platform=node --format=esm --outfile=.cache/smoke.mjs --log-level=warning && node .cache/smoke.mjs",
    "test": "npm run typecheck && npm run test:invariants && npm run test:saves && npm run test:lines && npm run test:menu && npm run test:people && npm run test:mind && npm run test:settlements",
    "test:lines": "esbuild tools/lineClipCheck.ts --bundle --platform=node --format=esm --outfile=.cache/lines.mjs --log-level=warning && node .cache/lines.mjs",
    "test:people": "esbuild tools/peopleStoryCheck.ts --bundle --platform=node --format=esm --outfile=.cache/people.mjs --log-level=warning && node .cache/people.mjs",
    "test:menu": "esbuild tools/menuCheck.ts --bundle --platform=node --format=esm --outfile=.cache/menu.mjs --log-level=warning && node .cache/menu.mjs",
    "test:mind": "esbuild tools/mindGateCheck.ts --bundle --platform=node --format=esm --outfile=.cache/mind.mjs --log-level=warning && node .cache/mind.mjs",
    "test:settlements": "esbuild tools/settlementCheck.ts --bundle --platform=node --format=esm --outfile=.cache/settlements.mjs --log-level=warning && node .cache/settlements.mjs",
    "test:council": "esbuild tools/councilCheck.ts --bundle --platform=node --format=esm --outfile=.cache/council.mjs --log-level=warning && node .cache/council.mjs",
    "test:pace": "esbuild tools/paceCheck.ts --bundle --platform=node --format=esm --outfile=.cache/pace.mjs --log-level=warning && node .cache/pace.mjs",
    "test:moments": "esbuild tools/momentCheck.ts --bundle --platform=node --format=esm --outfile=.cache/moments.mjs --log-level=warning && node .cache/moments.mjs",
    "test:techcards": "esbuild tools/techCardsCheck.ts --bundle --platform=node --format=esm --outfile=.cache/techcards.mjs --log-level=warning && node .cache/techcards.mjs",
    "test:saves": "esbuild tools/saveCheck.ts --bundle --platform=node --format=esm --outfile=.cache/saves.mjs --log-level=warning && node .cache/saves.mjs",
    "test:visual": "node tools/visual/visualCheck.mjs"
  },
  "dependencies": {
    "pako": "^2.1.0",
    "pixi.js": "^8.17.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "esbuild": "^0.27.3",
    "playwright": "1.56.0",
    "pngjs": "7.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1"
  }
}
